{
  "version": 6,
  "configurePresets": [
    {
      "name": "windows",
      "displayName": "Windows x64 (Visual Studio 2026)",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/windows",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-md"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "windows",
      "configuration": "Debug"
    },
    {
      "name": "release",
      "configurePreset": "windows",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "unit",
      "configurePreset": "windows",
      "configuration": "Debug",
      "filter": {
        "include": {
          "label": "unit"
        }
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "live",
      "configurePreset": "windows",
      "configuration": "Debug",
      "filter": {
        "include": {
          "label": "live"
        }
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "ui",
      "configurePreset": "windows",
      "configuration": "Debug",
      "filter": {
        "include": {
          "label": "ui"
        }
      },
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
